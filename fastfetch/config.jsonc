{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": { "source": "arch", "type": "builtin", "color": { "1": "magenta", "2": "cyan" }, "padding": { "top": 1, "left": 2, "right": 3 } },
  "display": { "separator": "  ", "color": { "keys": "cyan", "title": "magenta" } },
  "modules": [
    { "type": "custom", "format": "\u001b[95m  dap_\u001b[0m  ·  \u001b[96md-ap.my.id\u001b[0m" },
    "break",
    { "type": "os",       "key": " OS     " },
    { "type": "kernel",   "key": " Kernel " },
    { "type": "wm",       "key": " WM     " },
    { "type": "terminal", "key": " Term   " },
    { "type": "shell",    "key": " Shell  " },
    { "type": "cpu",      "key": " CPU    " },
    { "type": "gpu",      "key": " GPU    " },
    { "type": "memory",   "key": " RAM    " },
    { "type": "swap",     "key": " zram   " },
    { "type": "disk",     "key": " Disk   " },
    { "type": "uptime",   "key": " Uptime " },
    "break",
    "colors"
  ]
}
